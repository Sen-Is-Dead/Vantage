# Copy to .env and fill in. .env is gitignored. NEVER commit real values.

# --- Postgres (Supabase) ---
# Direct connection (port 5432). Used by local scripts and the GitHub Actions weekly job.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooled / pgbouncer connection (port 6543). Used by the Vercel dashboard's serverless functions (Phase 7).
DATABASE_URL_POOLED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- FPL ---
FPL_TEAM_ID=3964630
# Comma-separated FPL web_names that must never be recommended for transfer-out unless the
# FPL API marks them injured/suspended (Safety Rule 2). Matched case-insensitively.
PROTECTED_PLAYERS=Mbeumo

# --- Understat (optional supplementary xG source; the pipeline runs without it) ---
UNDERSTAT_ENABLED=false

# --- Phase 8 only (auto-submit). Not used before then. Never put a password in a file. ---
# FPL_EMAIL=
